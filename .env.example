# Firebase Phone Authentication (web app config — safe to expose in the browser)
# Leave empty to run OTP in demo mode (any 6-digit code).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Artistry backend (PH-Artistry/backend) for the admin area at /admin and the live gold rates.
# Leave empty to run the storefront on its built-in data with no admin area.
# Local development: http://localhost:5000/api
VITE_BACKEND_URL=
